# Copy to .env. Nothing here is a real secret; all values are local-dev defaults.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/assess
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/assess_test
JWT_SECRET=dev-only-change-me
UPLOAD_DIR=./uploads

# LLM: mock (default, offline) | ollama | gemini
LLM_PROVIDER=mock
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
LLM_TOKEN_BUDGET_PER_EVAL=60000

# Optional integrations
GOOGLE_API_KEY=
WHISPER_ENABLED=false

# Queue tuning
JOB_MAX_ATTEMPTS=3
JOB_LEASE_SECONDS=60
